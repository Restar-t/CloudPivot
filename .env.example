# ============================================================
# 网盘项目环境配置模板
# 复制为 .env 后按需修改；不要把真实密码提交到版本库
#   cp .env.example .env
# ============================================================

# ---------- 基础 ----------
TZ=Asia/Shanghai
ENV=dev
DEBUG=true

# ---------- MySQL（compose 内 backend 会覆盖 MYSQL_HOST=mysql）----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=netdisk
MYSQL_USER=netdisk
MYSQL_PASSWORD=change_me_app
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ---------- Redis（compose 内 backend 会覆盖 REDIS_HOST=redis）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MinIO（compose 内 backend 会覆盖 MINIO_ENDPOINT=minio:9000）----------
MINIO_ROOT_USER=netdisk
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_BUCKET_FORMAL=netdisk-formal
MINIO_BUCKET_CANDIDATE=netdisk-candidate

# ---------- 应用 ----------
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---------- 安全（M1 生效；生产务必替换为随机值）----------
JWT_SECRET_KEY=change_me_random_32_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
LOGIN_FAIL_THRESHOLD=5
LOGIN_FAIL_WINDOW_SECONDS=900

# ---------- 上传限制（M3 生效；CODING_PLAN §7 约定值）----------
UPLOAD_MAX_FILE_SIZE=5368709120
UPLOAD_CHUNK_SIZE=8388608
UPLOAD_CHUNK_CONCURRENCY=4
UPLOAD_TYPE_WHITELIST=jpg,jpeg,png,gif,webp,bmp,ico,pdf,txt,md,csv,json,log,doc,docx,xls,xlsx,ppt,pptx,zip,rar,7z,tar,gz,mp4,mp3,wav,mkv

# ---------- 治理参数（可降级配置，PLAN §七 降级预案）----------
TRASH_RETENTION_DAYS=30
CANDIDATE_GRACE_HOURS=24
UPLOAD_TASK_TTL_HOURS=168
SHARE_TRANSFER_RECHECK_SECONDS=3
DOWNLOAD_RATE_LIMIT_BYTES=2097152
DOWNLOAD_RATE_BURST_BYTES=8388608

# ---------- MinIO 封装层 ----------
MINIO_POOL_WORKERS=16
BUCKET_INIT_RETRIES=3
BUCKET_INIT_DELAY_SECONDS=2
